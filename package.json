{
  "name": "ocm",
  "version": "0.1.0",
  "description": "Manage OpenCode provider config and API-key storage",
  "type": "module",
  "bin": {
    "ocm": "dist/ocm"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
